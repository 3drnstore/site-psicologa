{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PsicoGestão",
  "version": "0.1.0",
  "identifier": "br.com.psicogestao.desktop",
  "build": {
    "frontendDist": "https://site-psicologa.thiagodrn2.workers.dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PsicoGestão",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "PsicoGestão para Windows",
    "longDescription": "Aplicativo desktop do PsicoGestão para acesso ao painel e aos recursos do sistema no Windows."
  }
}
